# ==========================================
# Dua Card (দোয়া কার্ড) Environment Variables
# ==========================================

# 1. NextAuth Authentication Secret
# Generate a secure 32+ character random string with: `openssl rand -base64 32` or `npx auth secret`
AUTH_SECRET=your_auth_secret_here

# 2. Canonical Application URL (required in production)
# Example for Vercel: https://your-dua-card-domain.vercel.app
# For local development: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# 3. Google OAuth Credentials
# Obtain from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
# Authorized JavaScript origin: https://your-dua-card-domain.vercel.app (and http://localhost:3000 for dev)
# Authorized redirect URI: https://your-dua-card-domain.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret

# 4. Strict Whitelisted Google Account
# ONLY this single Google email address will be permitted to sign in.
# All other Google accounts are immediately rejected with an unauthorized screen.
ALLOWED_GOOGLE_EMAIL=your.private.email@gmail.com
