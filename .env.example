# ==========================================
# Dua Card (দোয়া কার্ড) Environment Variables
# ==========================================

# ------------------------------------------
# ১. গুগল সাইন-ইন (Google OAuth 2.0 - সম্পূর্ণ ফ্রি)
# ------------------------------------------
# Google Cloud Console (https://console.cloud.google.com) থেকে ২ মিনিটে পাবেন:
# 1. APIs & Services > Credentials > Create Credentials > OAuth client ID
# 2. Application type: Web application
# 3. Authorized JavaScript origins:
#    - http://localhost:3000
#    - https://your-dua-card-domain.vercel.app
# 4. Authorized redirect URIs:
#    - http://localhost:3000/api/auth/callback/google
#    - https://your-dua-card-domain.vercel.app/api/auth/callback/google
#
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret

# ------------------------------------------
# ২. সিক্রেট কী (JWT সেশন সাইন করার জন্য)
# ------------------------------------------
# যেকোনো সুরক্ষিত বড় র‍্যান্ডম স্ট্রিং:
AUTH_SECRET=dua_card_super_secret_jwt_encryption_key_2026_vercel

# ------------------------------------------
# ৩. ইমেইল/পাসওয়ার্ড ফলব্যাক (ব্যক্তিগত লগইন)
# ------------------------------------------
ADMIN_EMAIL=admin@duacard.app
ADMIN_PASSWORD=admin

# ------------------------------------------
# ৪. ফ্রি ক্লাউড ডাটাবেজ (Supabase - আজীবন ফ্রি)
# ------------------------------------------
# Supabase (https://supabase.com) থেকে ফ্রি প্রজেক্টের তথ্য:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------
# ৫. অ্যাপ ইউআরএল
# ------------------------------------------
NEXTAUTH_URL=http://localhost:3000
